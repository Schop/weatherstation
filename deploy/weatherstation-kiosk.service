[Unit]
Description=Weather Station Kiosk (Chromium)
After=graphical.target weatherstation.service
Wants=weatherstation.service

[Service]
User=__USER__
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/__USER__/.Xauthority
# Wait until the X server accepts connections and the Flask server answers
ExecStartPre=/bin/sh -c 'until xset q >/dev/null 2>&1; do sleep 1; done'
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:5000/api/ping >/dev/null; do sleep 1; done'
# No screen blanking / power saving
ExecStartPre=/bin/sh -c 'xset s off; xset -dpms; xset s noblank'
# unclutter hides the mouse pointer; Chromium runs fullscreen in kiosk mode
ExecStart=/bin/bash -c 'unclutter -idle 0.1 -root & exec __CHROMIUM__ --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble --disk-cache-size=1 --cursor=none http://localhost:5000'
TimeoutStartSec=infinity
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
