[Unit]
Description=Weather Station Kiosk (Chromium)
After=graphical.target weatherstation.service
Wants=weatherstation.service

[Service]
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=chromium-browser --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble http://localhost:5000
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
